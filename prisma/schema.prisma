// learn more about it in the docs: https://pris.ly/d/prisma-schema

//npx prisma generate
//npx prisma migrate dev
//npx prisma studio
//inserir no .env DATABASE_URL="file:./dev.db"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")//ignora
}

//tabelas do usuario
model usuarios {
  id         Int @id @default(autoincrement())
  name String @default("Usuário Antigo")  
  nome       String   @unique
  email      String   @unique
  password   String
  profile_picture_url String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lojas      lojas[]
  avaliacoesLoja avaliacoesLoja[]
  comentariosAvaliacoes comentariosAvaliacoes[]
  avaliacoesProduto avaliacoesProduto[]
 
}
//tabela das lojas
model lojas {
  id         Int @id @default(autoincrement())

  usuarioId  Int 
  usuario    usuarios @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  
  nome       String
  categoria  String @default("Geral")
  descricao  String?
  logoUrl    String
  bannerUrl  String
  stickerUrl String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  avaliacoesLoja avaliacoesLoja[]
  produtos produtos[]
}

//tabela da avaliação da loja
model avaliacoesLoja {
  id         Int @id @default(autoincrement())

  usuarioId  Int  
  usuario    usuarios @relation(fields: [usuarioId],  references: [id], onDelete: Cascade)

  lojaId     Int 
  loja       lojas @relation(fields: [lojaId], references: [id], onDelete: Cascade)


  nota       Int
  comentario String? 
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([usuarioId, lojaId])
}
//tabela com as avaliações dos produtos
model avaliacoesProduto {
  id         Int @id @default(autoincrement())

  usuarioId  Int
  usuario    usuarios @relation(fields: [usuarioId], references: [id])

  productId  Int
  produto    produtos @relation(fields: [productId], references: [id])

  nota       Int
  comentario String?

  comentariosAvaliacoes comentariosAvaliacoes[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([usuarioId, productId])
}
//tabela para os comentarios
// //tabela para os comentarios
model comentariosAvaliacoes {
  id                 Int               @id @default(autoincrement())
  usuarioId          Int
  usuario            usuarios          @relation(fields: [usuarioId], references: [id])
  
  avaliacaoProdutoId Int
  avaliacaoProduto   avaliacoesProduto @relation(fields: [avaliacaoProdutoId], references: [id])
  
  conteudo           String
  createdAt          DateTime          @default(now())
}

//tabelas das categorias
model categorias {
  id         Int @id @default(autoincrement()) //link para parentcategory
  name       String 

  parentCategoryId Int? 
  parentCategory   categorias?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: Cascade)
  subCategories    categorias[] @relation("CategoryHierarchy")

  produtos    produtos[]
}

//tabela dos  produtos
model produtos {
  id         Int @id @default(autoincrement())

  lojaId     Int 
  lojas       lojas @relation(fields: [lojaId], references: [id], onDelete: Cascade)
  
  categoriaId Int 
  categoria    categorias @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  name        String
  description String?
  preco       Float 
  estoque     Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  
  avaliacoesProduto avaliacoesProduto[]
  imagens imagensProdutos[]
  
}
//tabela das imagens
model imagensProdutos {
  id         Int @id @default(autoincrement())

  produtoId  Int 
  produto    produtos @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  imageUrl   String
  ordem      Int
}